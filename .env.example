# DevOps Learning OS environment configuration
# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored; never commit real credentials.

# ---------- Application ----------
# PORT: HTTP port the server listens on (default 3000)
PORT=3000

# AUTH_SECRET: Secret key for signing JSON Web Tokens. Use a long random value.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="devops-learning-os-jwt-secret-change-in-production"

# ---------- Database (direct server use) ----------
# DATABASE_URL: PostgreSQL connection string (Prisma ORM).
# When set, all learning data is persisted to PostgreSQL.
# When unset, the app runs with an in-memory store (local dev / preview only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_os?schema=public"

# ---------- Docker Compose overrides (optional) ----------
# docker-compose.yml reads these when you run `docker compose up`.
# The defaults inside docker-compose.yml are for local development only.
# Override them here (or via shell env) with real values for anything exposed.
# POSTGRES_USER=devops_admin
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_DB=devops_learning_os
# POSTGRES_PORT=5432
# APP_PORT=3000
